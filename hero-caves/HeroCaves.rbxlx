            <bool name="CanQuery">false</bool>
            <Vector3 name="size">
              <X>0.08</X>
              <Y>1.85</Y>
              <Z>0.035</Z>
            </Vector3>
            <CoordinateFrame name="CFrame">
              <X>1.38</X>
              <Y>0.7</Y>
              <Z>-0.96</Z>
