              <R12>0</R12>
              <R20>0</R20>
              <R21>0</R21>
              <R22>1</R22>
            </CoordinateFrame>
            <Color3 name="Color">
              <R>0.788235294117647</R>
              <G>0.8627450980392157</G>
              <B>0.8980392156862745</B>
            </Color3>
