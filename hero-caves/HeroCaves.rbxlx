        <Item class="Part" referent="PaladinP48">
          <Properties>
            <string name="Name">SwordTip</string>
            <bool name="Anchored">true</bool>
            <bool name="CanCollide">false</bool>
            <bool name="CanTouch">false</bool>
            <bool name="CanQuery">false</bool>
            <Vector3 name="size">
              <X>0.26</X>
              <Y>0.32</Y>
              <Z>0.13</Z>
            </Vector3>
            <CoordinateFrame name="CFrame">
              <X>1.38</X>
              <Y>1.94</Y>
              <Z>-0.88</Z>
              <R00>1</R00>
              <R01>0</R01>
              <R02>0</R02>
              <R10>0</R10>
              <R11>1</R11>
              <R12>0</R12>
              <R20>0</R20>
              <R21>0</R21>
              <R22>1</R22>
            </CoordinateFrame>
            <Color3 name="Color">
              <R>0.8745098039215686</R>
              <G>0.9137254901960784</G>
              <B>0.9411764705882353</B>
            </Color3>
